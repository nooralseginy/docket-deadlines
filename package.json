{
  "name": "docket-deadlines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "preview": "python3 -m http.server 3000 --directory out --bind 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test lib/*.test.ts lib/rules/*.test.ts",
    "fetch:dockets": "node --env-file-if-exists=.env --import tsx scripts/fetch-dockets.ts",
    "extract": "node --env-file-if-exists=.env --import tsx scripts/extract.ts",
    "extract:baseline": "node --import tsx scripts/extract.ts --baseline",
    "eval": "node --import tsx scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "tailwindcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
